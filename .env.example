# Supabase Configuration
# Copy this file to .env and fill in your actual values
# The .env file is in .gitignore for security - never commit it!

# Supabase Project URL
SUPABASE_URL=

# Supabase Anonymous Key (public key - safe to expose in client)
SUPABASE_ANON_KEY=

# Supabase Service Role Key (secret key - admin operations only!)
# This key is required for admin features (approving/rejecting user requests)
# Keep this key secure and never expose it publicly
# Get this from: Supabase Dashboard → Settings → API → Service Role Secret
SUPABASE_SERVICE_ROLE_KEY=

# Environment (development, staging, production)
ENVIRONMENT=
